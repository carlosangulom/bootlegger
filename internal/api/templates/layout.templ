package templates

templ Layout(title string) {
	<!DOCTYPE html>
	<html lang="en">
		<head>
			<meta charset="UTF-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0"/>
			<title>{ title }</title>
			<script src="https://cdn.tailwindcss.com"></script>
			<script>
				tailwind.config = {
					theme: {
						extend: {
							colors: {
								bg:      '#0d0f11',
								panel:   '#14171a',
								accent:  '#ffb000',
								success: '#00ff88',
								danger:  '#ff4d4d',
								wire:    '#2a2d31',
								muted:   '#8a8f98',
							},
							fontFamily: { mono: ['monospace'] }
						}
					}
				}
			</script>
			<script src="https://unpkg.com/htmx.org@2.0.4"></script>
			<script src="https://unpkg.com/htmx-ext-sse@2.2.2/sse.js"></script>
			<script defer src="https://unpkg.com/alpinejs@3.14.1/dist/cdn.min.js"></script>
			<script src="https://unpkg.com/wavesurfer.js@7/dist/wavesurfer.min.js"></script>
		</head>
		<body class="min-h-screen bg-bg text-gray-200 font-mono p-6">
			{ children... }
			<script>
				// btlggrPlayer — shared Alpine component for the post-pipeline track player.
				// Defined here so it is registered before Alpine initialises and is available
				// when the SSE-swapped content injects x-data="btlggrPlayer" into the DOM.
				document.addEventListener('alpine:init', () => {
					Alpine.data('btlggrPlayer', () => ({
						tracks:      [],
						idx:         0,
						ws:          null,
						playing:     false,
						currentTime: 0,
						duration:    0,

						init() {
							try { this.tracks = JSON.parse(this.$el.dataset.tracks || '[]'); } catch(e) {}
						},

						get current() { return this.tracks[this.idx] || null; },

						// Load track at index i, tear down any running WaveSurfer first.
						loadTrack(i) {
							if (i < 0 || i >= this.tracks.length) return;
							this.idx         = i;
							this.currentTime = 0;
							this.duration    = 0;
							this.playing     = false;
							if (this.ws) { this.ws.destroy(); this.ws = null; }
							this.$nextTick(() => this._start());
						},

						// Create and auto-play a WaveSurfer instance for the current track.
						_start() {
							if (!this.current || typeof WaveSurfer === 'undefined') return;
							const el = this.$refs.wave;
							if (!el) return;
							this.ws = WaveSurfer.create({
								container:     el,
								waveColor:     '#2a2d31',
								progressColor: '#ffb000',
								cursorColor:   '#ffb000',
								url:           this.current.url,
								height:        64,
								barWidth:      2,
								barGap:        1,
								normalize:     true,
							});
							this.ws.on('ready',      () => { this.duration = this.ws.getDuration(); this.ws.play(); });
							this.ws.on('play',       () => { this.playing = true; });
							this.ws.on('pause',      () => { this.playing = false; });
							this.ws.on('finish',     () => { this.playing = false; this.next(); });
							this.ws.on('timeupdate', (t) => { this.currentTime = t; this.duration = this.ws.getDuration() || this.duration; });
						},

						toggle() {
							if (!this.ws) { this._start(); return; }
							this.ws.playPause();
						},

						prev() { this.loadTrack(this.idx - 1); },
						next() { this.loadTrack(this.idx + 1); },

						// Called by track row clicks; i=-1 means non-playable row.
						select(i) {
							if (i < 0) return;
							if (i === this.idx) { this.toggle(); } else { this.loadTrack(i); }
						},

						fmt(s) {
							if (!s || isNaN(s)) return '0:00';
							const m  = Math.floor(s / 60);
							const sc = Math.floor(s % 60);
							return m + ':' + String(sc).padStart(2, '0');
						},
					}));
				});
			</script>
		</body>
	</html>
}
